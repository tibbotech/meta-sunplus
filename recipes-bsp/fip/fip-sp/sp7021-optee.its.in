/dts-v1/;

/ {
 description = "Kernel Image with OP-TEE and DTB";
 creator = "U-Boot mkimage";

 images {
	kernel-1 {
	    data = /incbin/("${DEPLOY_DIR_IMAGE}/${DV_K_IFINITR}");
	    description = "${MACHINE} kernel ${DV_K_IFINITR}";
	    type = "kernel";
	    arch = "arm";
	    os = "linux";
	    compression = "none";
	    load = <0x308000>;
	    entry = <0x308040>;
	    hash-1 {
		algo = "crc32";
	    };
	};

	optee-1 {
	    description = "${MACHINE} op-tee";
            data = /incbin/("${DEPLOY_DIR_IMAGE}/optee/tee.bin");
	    type = "tee";
	    arch = "arm";
	    os = "tee";
	    compression = "none";
	    load = <0x10000>; /* Must match OP-TEE compiled base CFG_TEE_CORE_NB_PA */
	    entry = <0x10000>;
	    hash-1 {
		algo = "crc32";
	    };
	};

	fdt-1 {
            data = /incbin/("${DEPLOY_DIR_IMAGE}/${ISP_VAR_DTB}");
	    description = "${MACHINE} dtb ${ISP_VAR_DTB}";
	    type = "flat_dt";
	    arch = "arm";
	    compression = "none";
	    load = <0x300000>;
	    entry = <0x300000>;
	    hash-1 {
		algo = "crc32";
	    };
	};
 };

 configurations {
	default = "conf-1";
	conf-1 {
	    description = "${MACHINE} ${ISP_VAR_DTB} with OP-TEE";
	    kernel = "kernel-1";
	    loadables = "optee-1", "kernel-1";
	    tee = "optee-1";
	    fdt = "fdt-1";
	};
 };
};
